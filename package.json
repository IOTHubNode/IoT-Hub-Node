{
  "name": "iot-hub-node-workspace",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,green \"pnpm --filter @iothub/server dev\" \"pnpm --filter @iothub/web dev\"",
    "dev:server": "pnpm --filter @iothub/server dev",
    "dev:web": "pnpm --filter @iothub/web dev",
    "build": "pnpm --filter @iothub/shared build && pnpm --filter @iothub/web build && pnpm --filter @iothub/server build",
    "start": "pnpm --filter @iothub/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
